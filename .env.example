# Modèle de configuration : copie ces lignes dans .env (non versionné) et
# remplace les valeurs. Ne mets jamais de vraie clé dans ce fichier.

# --- Firebase (authentification et Firestore)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Chat IA (Documents › Fenêtre › Chat IA)
# Clés secrètes, SANS préfixe VITE_ : elles restent sur le serveur Vite
# (npm run dev / npm run preview) et ne sont jamais envoyées au navigateur.
# Chaque clé définie ajoute son fournisseur au sélecteur de modèles ; seuls les
# modèles réellement accessibles avec la clé sont proposés. Relance le serveur
# après une modification.

# Google Gemini, niveau gratuit : clé à créer sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq, niveau gratuit : https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter, modèles « :free » (50 requêtes/jour sans crédits) : https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OpenAI : payant uniquement (pas de niveau gratuit pour l'API)
OPENAI_API_KEY=

# Afficher aussi les modèles payants (facturés par le fournisseur) : true / false
IA_MODELES_PAYANTS=false
